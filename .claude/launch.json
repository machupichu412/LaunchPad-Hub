{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "launchpad-web",
      "runtimeExecutable": "/opt/homebrew/bin/node",
      "runtimeArgs": [
        "src/LaunchPad.Web/node_modules/vite/bin/vite.js",
        "src/LaunchPad.Web"
      ],
      "port": 5173
    },
    {
      "name": "launchpad-api",
      "runtimeExecutable": "/Users/mattyeh/.dotnet/dotnet",
      "runtimeArgs": [
        "run",
        "--launch-profile",
        "LocalDemo",
        "--project",
        "src/LaunchPad.Api"
      ],
      "port": 5254
    },
    {
      "name": "launchpad-web-personas",
      "runtimeExecutable": "/usr/bin/env",
      "runtimeArgs": [
        "VITE_DEV_PERSONAS=true",
        "VITE_MOCK_MODE=false",
        "VITE_API_BASE_URL=http://localhost:5254",
        "/opt/homebrew/bin/node",
        "src/LaunchPad.Web/node_modules/vite/bin/vite.js",
        "src/LaunchPad.Web"
      ],
      "port": 5173
    }
  ]
}
