    "ProgramOpsUpn": ""
  },
  "Storage": {
    "AccountUrl": ""
  },
  "SharePoint": {
    "SiteId": "",
    "DriveId": "",
    "RootFolderPath": "LaunchPad"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [ { "Name": "Console" } ]
  }
