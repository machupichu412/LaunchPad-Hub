{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "Audience": ""
  },
  "ConnectionStrings": {
    "Sql": "Server=tcp:launchpad-<env>.database.windows.net,1433;Database=launchpad;Authentication=Active Directory Default;Encrypt=True;"
  },
  "ServiceBus": {
    "Namespace": "launchpad-<env>.servicebus.windows.net",
    "QueueName": "matching-jobs"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [ { "Name": "Console" } ]
  }
}
