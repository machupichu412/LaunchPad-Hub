<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>launchpad-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Web" Version="4.14.1" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.22.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.ApplicationInsights" Version="4.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" Version="9.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.AzureServiceBus" Version="9.0.0" />
    <!-- Local-demo-only: lets Program.cs swap in an in-memory DbContext when no SQL
         Server is reachable. Never referenced by Infrastructure/Functions.
         Release keeps the compile asset (Program.cs still references UseInMemoryDatabase)
         but drops the runtime DLL, so a demo-only provider never ships to an environment
         that has real SQL. The path that uses it is Development-gated anyway (Program.cs
         `useInMemoryForLocalDemo`); this just stops it being present to select at all.
         Tests reference the package directly, so `dotnet test -c Release` is unaffected. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.0">
      <ExcludeAssets Condition="'$(Configuration)' == 'Release'">runtime</ExcludeAssets>
    </PackageReference>
    <!-- Pinned to patch transitive advisories, not because the API calls either directly.
         Microsoft.Identity.Web 4.14.1 resolves both at 9.0.18, which carries GHSA-846f-f764-76mx
         (Pkcs, high) and GHSA-r955-8q5j-3h83 / -7hqp-7c5m-4vq6 / -c399-9853-6jmj (Xml, high).
         Drop these pins once Identity.Web's own dependency moves past them. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="9.0.21" />
    <!-- Required by `dotnet ef` when the API is the startup project for migrations. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LaunchPad.Application\LaunchPad.Application.csproj" />
    <ProjectReference Include="..\LaunchPad.Infrastructure\LaunchPad.Infrastructure.csproj" />
  </ItemGroup>

</Project>
